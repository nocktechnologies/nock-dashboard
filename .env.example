# ── Django Core ──────────────────────────────────────────────────────────────
# Required: generate with `python -c "import secrets; print(secrets.token_hex(50))"`
SECRET_KEY=

# Required: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Comma-separated list for key rotation; first key is used for encryption.
FERNET_KEYS=

DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ── Database & Cache ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379/0

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_API_KEY=

# ── OpenAI (used for Research Library embeddings) ─────────────────────────────
OPENAI_API_KEY=

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
GITHUB_PAT=

# ── NockCC ────────────────────────────────────────────────────────────────────
NOCKCC_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print(v.public_key, v.private_key)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:noreply@yourdomain.com

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_QUIET_START=23
TELEGRAM_QUIET_END=7

# ── Morning Note (Brain App) ──────────────────────────────────────────────────
MORNING_NOTE_ENABLED=False
MORNING_NOTE_HOUR_UTC=11
MORNING_NOTE_AI_QUESTIONS=True

# ── Remote Agent ──────────────────────────────────────────────────────────────
AGENT_HMAC_KEY=
ALLOWED_COMMAND_IPS=

# ── Notifications / Webhooks ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── Stripe Billing ────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from: https://dashboard.stripe.com/products
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_FLEET_PRICE_ID=price_...
